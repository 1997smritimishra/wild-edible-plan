# ── Server ────────────────────────────────────────────────
PORT=8080

# ── PostgreSQL ─────────────────────────────────────────────
DB_HOST=192.24.10.56
DB_PORT=5432
DB_NAME=wildplant
DB_USER=postgres
DB_PASS=postgres

# ── AES-256 — must match Angular CryptoService SECRET_KEY ──
CRYPTO_KEY="PlantMap$SecureKey#2026!AES256!!"

# ── Twilio SMS (OTP delivery) ──────────────────────────────
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── File upload folders ────────────────────────────────────
UPLOAD_DIR=uploads
GDAL_OUTPUT_DIR=uploads/gdal_output
